---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  kicker: string;
  summary: string;
  hero?: ImageMetadata;
  heroAlt?: string;
}

const { href, title, kicker, summary, hero, heroAlt } = Astro.props;
---

<a href={href} class="group block no-underline">
  {
    hero ? (
      <Image
        src={hero}
        alt={heroAlt ?? ''}
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 363px"
        class="mb-4 aspect-[4/3] w-full border border-line object-cover"
      />
    ) : (
      <div class="placeholder mb-4 aspect-[4/3] w-full">
        screenshot
        <br />
        4:3
      </div>
    )
  }
  <div class="eyebrow mb-2 text-[10.5px] tracking-[0.14em] text-accent">{kicker}</div>
  <h3 class="mb-[7px] font-sans text-[18px] font-semibold leading-[1.4] text-ink group-hover:text-accent">
    {title}
  </h3>
  <p class="text-[14.5px] leading-[1.65] text-body [text-wrap:pretty]">{summary}</p>
  <div class="eyebrow mt-3 text-[10.5px] text-accent">View &rarr;</div>
</a>
