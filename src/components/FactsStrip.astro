---
interface Props {
  role: string;
  years: string;
  stack: string[];
  client: string;
}

const { role, years, stack, client } = Astro.props;

const facts = [
  { label: 'Role', value: role },
  { label: 'Year', value: years },
  { label: 'Stack', value: stack.join(' · ') },
  { label: 'For', value: client },
];
---

<div class="grid grid-cols-2 gap-5 border-b border-line py-[26px] md:grid-cols-4">
  {
    facts.map((f) => (
      <div>
        <div class="eyebrow mb-[7px] text-[10px] text-accent">{f.label}</div>
        <div class="text-[14.5px] font-medium leading-[1.45] text-ink">{f.value}</div>
      </div>
    ))
  }
</div>
