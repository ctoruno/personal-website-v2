---
import PostMeta from './PostMeta.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  topic: string;
  minutesRead: number;
}

const { href, title, summary, date, topic, minutesRead } = Astro.props;
---

<article class="py-[30px] first:pt-0 last:pb-0">
  <div class="mb-3">
    <PostMeta date={date} detail={`${topic} · ${minutesRead} min`} />
  </div>
  <h2 class="mb-[10px] font-sans text-[21px] font-semibold leading-[1.35] tracking-[-0.025em]">
    <a class="text-ink no-underline hover:text-accent" href={href}>{title}</a>
  </h2>
  <p class="text-[15px] leading-[1.7] text-body [text-wrap:pretty]">{summary}</p>
</article>
