---
interface Ref {
  href: string;
  title: string;
}

interface Props {
  prev?: Ref;
  next?: Ref;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="grid grid-cols-2 gap-6 border-t border-line pt-6" aria-label="Adjacent entries">
      <div>
        {prev && (
          <a href={prev.href} class="block no-underline">
            <div class="eyebrow mb-[9px] text-[10.5px] text-faint">&larr; Previous</div>
            <div class="text-[16px] font-medium leading-[1.45] text-ink">{prev.title}</div>
          </a>
        )}
      </div>
      <div class="text-right">
        {next && (
          <a href={next.href} class="block no-underline">
            <div class="eyebrow mb-[9px] text-[10.5px] text-faint">Next &rarr;</div>
            <div class="text-[16px] font-medium leading-[1.45] text-ink">{next.title}</div>
          </a>
        )}
      </div>
    </nav>
  )
}
