---
interface Props {
  id: string;
  title: string;
  /** Extra query params, e.g. "start=865". */
  params?: string;
}

const { id, title, params } = Astro.props;

const src = `https://www.youtube-nocookie.com/embed/${id}${params ? `?${params}` : ''}`;
---

<div class="mb-[34px] aspect-video">
  <iframe
    class="h-full w-full border-0"
    src={src}
    title={title}
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen></iframe>
</div>
